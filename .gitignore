# Godot 4 - generated local data
.godot/
*.translation
game/android/build/

# Build output and private signing keys
build/
*.apk
*.aab
*.keystore
*.jks

# Python generated output
__pycache__/
*.pyc
.venv/

# Blender generated backups
*.blend1
*.blend2

# Local OS and IDE state
Thumbs.db
desktop.ini
.DS_Store
.vscode/
